# Disable directory browsing
Options -Indexes

# Protect database files & sensitive configs
<FilesMatch "(database\.sqlite|config\.php|\.sql)$">
    # Deny direct browser access to sensitive sqlite file
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Allow public access to database.sql for downloading if explicitly needed, or keep protected
<Files "database.sql">
    <IfModule mod_authz_core.c>
        Require all granted
    </IfModule>
</Files>

# Character encoding & MIME types
AddDefaultCharset UTF-8
AddType image/svg+xml .svg .svgz

# Enable Compression if available
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

# Browser Caching for static assets
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/gif "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
</IfModule>

# SPA Rewrite Rule for /admin and client routing
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /
    RewriteRule ^index\.html$ - [L]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule . /index.html [L]
</IfModule>
